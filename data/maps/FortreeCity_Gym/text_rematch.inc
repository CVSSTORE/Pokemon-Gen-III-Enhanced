FortreeCity_Gym_Text_WinonaRematchIntro:: @ 8186000
	.string "Oh! {PLAYER}! Welcome back!\p"
	.string "My POKéMON and I have been soaring\n"
	.string "to new heights since we last met!$"

FortreeCity_Gym_Text_WinonaRematchAsk:: @ 8186060
	.string "Would you like to battle again?$"

FortreeCity_Gym_Text_WinonaRematchDecline:: @ 8186088
	.string "That's fine. Feel free to visit\n"
	.string "whenever you're ready.$"

FortreeCity_Gym_Text_WinonaRematchAccept:: @ 81860C0
	.string "Wonderful! Let's take to the skies!$"

FortreeCity_Gym_Text_WinonaRematchDefeat:: @ 81860F0
	.string "You've truly mastered the art of\n"
	.string "POKéMON battles!$"

FortreeCity_Gym_Text_WinonaGiveSharpBeak:: @ 8186130
	.string "That was a magnificent battle!\n"
	.string "Please accept this gift.$"

FortreeCity_Gym_Text_WinonaExplainSharpBeak:: @ 8186170
	.string "The SHARP BEAK enhances the power\n"
	.string "of FLYING-type moves.\p"
	.string "May you continue to soar high!$"

FortreeCity_Gym_Text_WinonaRematchPostBattle:: @ 81861C0
	.string "I love watching POKéMON fly through\n"
	.string "the sky. Come back anytime!$"
